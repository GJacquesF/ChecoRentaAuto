<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardItemRenta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#C7F0C7"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Folio -->
        <TextView
            android:id="@+id/lblFolio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folio: #0012"
            android:textColor="#195D19"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Cliente -->
        <TextView
            android:id="@+id/lblCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cliente: Juan Pérez"
            android:textColor="#0F380F"
            android:textSize="14sp" />

        <!-- Vehículo -->
        <TextView
            android:id="@+id/lblVehiculo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Vehículo: Toyota Corolla"
            android:textColor="#0F380F"
            android:textSize="14sp" />

        <!-- Fechas -->
        <TextView
            android:id="@+id/lblFechas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Fechas: 24/08 al 28/08"
            android:textColor="#0F380F"
            android:textSize="14sp" />

        <!-- Total y Estado de la renta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total: $2,000"
                android:textColor="#0F380F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblEstadoRenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVA"
                android:textColor="#2CA52C"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>