<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBFAEB">

    <!-- 1. Toolbar superior -->
    <include
        android:id="@+id/includeToolbar"
        layout="@layout/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. ScrollView anclado entre la Toolbar y el Botón inferior -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnRegistrarDevolucion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/includeToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Etiqueta Buscar Placa / Folio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar Placa / Folio"
                android:textColor="#0F380F"
                android:textStyle="bold" />

            <!-- Buscador: EditText + ImageButton -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/txtBuscarPlacaFolio"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@android:drawable/editbox_background"
                    android:hint="Ej. ABC-123"
                    android:inputType="textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#0F380F" />

                <ImageButton
                    android:id="@+id/btnBuscarRenta"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="#36C936"
                    android:contentDescription="Buscar"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <!-- CardView Información de Renta -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfoRenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeColor="#C7F0C7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="INFORMACIÓN DE RENTA"
                        android:textColor="#195D19"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblClienteInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cliente: Juan Pérez"
                        android:textColor="#0F380F"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lblVehiculoInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Vehículo: Toyota Corolla"
                        android:textColor="#0F380F"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lblFechaFinInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Fecha Fin: 28/08/2026"
                        android:textColor="#0F380F"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#EBFAEB" />

                    <TextView
                        android:id="@+id/lblAdeudoPendiente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adeudo Pendiente: $0.00"
                        android:textColor="#0F380F"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- 3. Botón Principal Fijo al fondo con margen -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegistrarDevolucion"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="REGISTRAR DEVOLUCIÓN"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#36C936"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>